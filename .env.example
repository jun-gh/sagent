# ==============================================================================
# SAGENT UNIFIED ENVIRONMENT CONFIGURATION
# Single source of truth for Local Dev, Docker Compose, and Cloud Deployment.
# ==============================================================================
# Deployment Key:
#   [RENDER]  -> Set in Render Dashboard (Backend Service Environment)
#   [VERCEL]  -> Set in Vercel Dashboard (Frontend Project Settings)
#   [GITHUB]  -> Set in GitHub Repository Settings (Secrets and Variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM CONFIGURATION [RENDER] [GITHUB]
# ------------------------------------------------------------------------------
# Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Active Gemini model for reasoning & multi-agent triage
# Options: gemini-3.1-flash-lite, gemini-2.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-3.1-flash-lite

# Active dense embedding model for Hybrid RAG vector search (768-dim)
EMBEDDING_MODEL=gemini-embedding-001


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION [RENDER]
# ------------------------------------------------------------------------------
# PostgreSQL connection string with pgvector extension support
# For Local Docker: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/sagent
# For Render / Neon: postgresql+asyncpg://<user>:<password>@<neon-host>/<db>?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/sagent


# ------------------------------------------------------------------------------
# 3. BACKEND RUNTIME & RETRY SETTINGS [RENDER]
# ------------------------------------------------------------------------------
APP_NAME=Sagent
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# AI Call Resilience (Exponential Backoff with Full Jitter)
MAX_GEMINI_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=10.0

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Session-Based Ticket History Settings
MAX_TICKET_PER_SESSION=10
SESSION_EXPIRY_DAYS=7


# ------------------------------------------------------------------------------
# 4. SECURITY & GUARDRAILS [RENDER] [VERCEL]
# ------------------------------------------------------------------------------
# Master switch for PII scrubbing & prompt injection guardrails
SECURITY_ENABLED=true

# Require API Key authentication on protected endpoints (/api/v1/tickets/*)
# Set to 'true' in production or hardened environments
REQUIRE_API_KEY=false

# Master API Key used for backend authentication
# [RENDER]: SAGENT_API_KEY=<secret-key>
# [VERCEL]: VITE_SAGENT_API_KEY=<secret-key> (must match SAGENT_API_KEY)
SAGENT_API_KEY=sagent-sec-key-2026

# Per-IP Rate Limiting (Sliding Window in requests per minute)
RATE_LIMIT_RPM=120

# Maximum automated refund amount (in USD) permitted without manager approval
MAX_AUTOMATED_REFUND_USD=250.0


# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT CONFIGURATION [VERCEL]
# ------------------------------------------------------------------------------
# Target backend API URL (leave empty in local dev to use Vite proxy /api)
# In production on Vercel: Set to your live Render backend URL (e.g. https://sagent-api.onrender.com)
VITE_API_URL=

# Client API key attached as 'X-API-Key' header on all outgoing frontend requests
VITE_SAGENT_API_KEY=sagent-sec-key-2026
